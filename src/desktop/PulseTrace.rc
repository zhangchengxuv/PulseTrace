#include <windows.h>
#include "resource.h"
IDI_PULSETRACE ICON "../../assets/PulseTrace.ico"
1 RT_MANIFEST "PulseTrace.manifest"
1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x2L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "PulseTrace local activity statistics"
      VALUE "FileVersion", "0.2.0-rc2"
      VALUE "ProductName", "PulseTrace"
      VALUE "ProductVersion", "0.2.0-rc2"
      VALUE "OriginalFilename", "PulseTrace.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
